{
  "name": "diff-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.config.perf.ts",
    "test:e2e": "playwright test",
    "size": "size-limit"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "comlink": "4.4.2",
    "diff": "9.0.0",
    "dompurify": "3.2.4",
    "lz-string": "1.5.0",
    "marked": "15.0.7",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.58.0",
    "@size-limit/file": "14.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.13.4",
    "eslint": "9.20.0",
    "eslint-plugin-svelte": "3.23.1",
    "fast-check": "4.10.2",
    "prettier": "3.5.0",
    "prettier-plugin-svelte": "3.3.3",
    "size-limit": "14.3.0",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
